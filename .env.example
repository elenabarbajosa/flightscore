# SerpApi credentials (server-side only; never commit real values)
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_flights

# Search result cache TTL in seconds (default: 1800)
CACHE_TTL_SECONDS=1800

# Upstash Redis REST credentials (required when VERCEL_ENV=production)
# Vercel Upstash integration injects KV_REST_API_*; UPSTASH_REDIS_* also supported.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
